# 複製成 functions/.env（不要 commit），Firebase Functions v2 會自動載入

# 任務 D — Routes API（Google Cloud Console 啟用 Routes API 後建立的 key）
GOOGLE_MAPS_API_KEY=

# 任務 B — 中央氣象署 opendata 授權碼 https://opendata.cwa.gov.tw/
CWA_API_KEY=

# 任務 C — Gemini
#
# 預設走 Vertex AI + Application Default Credentials，不需要 API key：
#   1. gcloud services enable aiplatform.googleapis.com
#   2. 服務帳號給 roles/aiplatform.user
#   3. 本機開發：gcloud auth application-default login
#   部署到 Cloud Functions 後 ADC 是自動的，這區塊整段可以留空。
#
# GEMINI_PROJECT_ID 通常不用設，ADC 會自己帶出來
GEMINI_PROJECT_ID=
GEMINI_LOCATION=us-central1
GEMINI_MODEL=gemini-3.1-flash-lite

# 只有在沒有 GCP 專案權限、要改走 AI Studio 時才填這個。
# 一旦填了就會自動改用 AI Studio（不再需要 ADC）。
GEMINI_API_KEY=

# 強制指定後端：vertex | aistudio（留空則依上面規則自動判斷）
GEMINI_BACKEND=

# 任務 B — 環境部環境資料開放平臺 api_key https://data.moenv.gov.tw/
MOENV_API_KEY=
