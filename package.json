{
  "name": "coolpath",
  "version": "1.0.0",
  "description": "涼路 CoolPath — 熱暴露評估引擎",
  "private": true,
  "scripts": {
    "dev": "node tools/dev_server.js",
    "preflight": "node tools/preflight.js",
    "deploy": "npm run preflight && cd functions && npm install && cd .. && firebase deploy",
    "deploy:web": "firebase deploy --only hosting",
    "deploy:api": "firebase deploy --only functions",
    "deploy:preview": "firebase hosting:channel:deploy demo",
    "test": "cd functions && npm test",
    "verify:lst": "node tools/verify_lst_grid.js",
    "lst:import-cog": "node tools/import_latest_lst_cog.js",
    "grid:placeholder": "node tools/make_placeholder_grid.js"
  },
  "devDependencies": {
    "geotiff": "^3.0.5"
  }
}
